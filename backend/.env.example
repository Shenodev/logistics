# Supabase — copy this file to `.env` and fill in real values.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Region of the Supabase project (see Supabase dashboard region selector).
SUPABASE_DB_REGION=eu-central-1

# Postgres connection (transaction pooler). Either paste the full URI from
# Supabase Dashboard > Database > Connection strings > Transaction pooler:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Or set the database password and the pooler URL is derived from SUPABASE_URL:
# SUPABASE_DB_PASSWORD=<database-password>

# Stripe — Visa refunds for cancelled orders (Admin only)
# Get from https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_API_VERSION=2024-06-20

# Resend — transactional emails from hello@contact.logistics.shenodev.tech
# Get from https://resend.com/api-keys
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=hello@contact.logistics.shenodev.tech
# RESEND_FROM_NAME=Sheno Logistics